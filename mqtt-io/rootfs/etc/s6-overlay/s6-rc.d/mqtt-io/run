#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: MQTT IO
# Runs MQTT IO
# ==============================================================================
declare configuration_file
declare mqtt_host
declare mqtt_password
declare mqtt_port
declare mqtt_username

# Deliberately without a document start marker, so it can also be appended to
# a file that already has one.
readonly DEFAULT_CONFIGURATION='mqtt:
  topic_prefix: mqtt_io
  ha_discovery:
    enabled: true
'

configuration_file=$(bashio::config 'configuration_file')

if ! bashio::fs.file_exists "${configuration_file}"; then
    if ! mkdir -p "$(dirname "${configuration_file}")"; then
        bashio::exit.nok "Could not create the folder holding the configuration file"
    fi

    printf '%s' "${DEFAULT_CONFIGURATION}" > "${configuration_file}"

    bashio::log.info "Created a default configuration file:"
    bashio::log.info "${configuration_file}"
    bashio::log.info
    bashio::log.info "It does not expose anything yet. Add the modules and"
    bashio::log.info "devices you want to use to it, and restart this app."
    bashio::log.info "See https://mqtt-io.app for the configuration format."
fi

# Leave a file we cannot parse alone. MQTT IO reports the problem with it in
# far more detail than we could here.
if ! python3 -c 'import sys, yaml; yaml.safe_load(open(sys.argv[1]))' \
    "${configuration_file}" 2> /dev/null; then
    bashio::log.fatal
    bashio::log.fatal "This is not a valid YAML file:"
    bashio::log.fatal "${configuration_file}"
    bashio::log.fatal
    bashio::log.fatal "Please correct it, or remove it to have a default"
    bashio::log.fatal "configuration file created in its place."
    bashio::log.fatal
    bashio::exit.nok
fi

# A file holding nothing but comments or whitespace parses to an empty
# document, which makes MQTT IO fail with "document is missing". Give it
# something to work with, keeping whatever the file already held.
if python3 -c 'import sys, yaml; sys.exit(1 if yaml.safe_load(open(sys.argv[1])) else 0)' \
    "${configuration_file}"; then
    printf '%s' "${DEFAULT_CONFIGURATION}" >> "${configuration_file}"
    bashio::log.warning "The configuration file held no configuration at all,"
    bashio::log.warning "so a default one has been added to it."
fi

# The MQTT server from the configuration file wins. Only when it does not set
# one, fall back to the MQTT server provided by an MQTT broker app.
mqtt_host=$(
    python3 -c 'import sys, yaml
config = yaml.safe_load(open(sys.argv[1])) or {}
print((config.get("mqtt") or {}).get("host") or "")' "${configuration_file}"
) || bashio::exit.nok "Could not read ${configuration_file}"

if bashio::var.is_empty "${mqtt_host}"; then
    if ! bashio::services.available 'mqtt'; then
        bashio::log.fatal
        bashio::log.fatal "No MQTT server is configured."
        bashio::log.fatal
        bashio::log.fatal "This app found no 'mqtt: host:' in:"
        bashio::log.fatal "${configuration_file}"
        bashio::log.fatal
        bashio::log.fatal "and no app is providing an MQTT server for it"
        bashio::log.fatal "to fall back on."
        bashio::log.fatal
        bashio::log.fatal "Either install and start an MQTT broker app, such"
        bashio::log.fatal "as the Mosquitto broker, or add the details of your"
        bashio::log.fatal "own MQTT server to the configuration file above."
        bashio::log.fatal
        bashio::exit.nok
    fi

    mqtt_host=$(bashio::services 'mqtt' 'host')
    mqtt_password=$(bashio::services 'mqtt' 'password')
    mqtt_port=$(bashio::services 'mqtt' 'port')
    mqtt_username=$(bashio::services 'mqtt' 'username')

    export MQTT_IO_HOST="${mqtt_host}"
    export MQTT_IO_PASSWORD="${mqtt_password}"
    export MQTT_IO_PORT="${mqtt_port}"
    export MQTT_IO_USER="${mqtt_username}"

    bashio::log.info "Using the MQTT server provided by the Supervisor."
fi

bashio::log.info "Starting MQTT IO..."
exec python3 -m mqtt_io "${configuration_file}"
